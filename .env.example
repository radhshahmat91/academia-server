# Copy to .env for local development   (Windows PowerShell: Copy-Item .env.example .env)
# Loaded automatically on start (Node 20.9 or newer)
PORT=5000
NODE_ENV=development

# Same connection string and database name as the Next.js client (client/.env.local). BetterAuth stores its users there.
# MongoDB Atlas (free): paste the string from Atlas, Connect, Drivers, for example
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# or use a MongoDB on this computer:
MONGODB_URI=mongodb://127.0.0.1:27017
# Pick a database name of your own. `npm run seed` replaces everything inside this database,
# and refuses to run when it finds collections that do not belong to AcademiaConnect (add --force to override).
MONGODB_DB=academiaconnect

# Optional: DNS servers to fall back on when this computer cannot look up an Atlas address (default 1.1.1.1,8.8.8.8).
# Write "system" to turn the fallback off.
# DNS_SERVERS=

# Comma separated list of allowed browser origins (the Next.js client)
CLIENT_URL=http://localhost:3000

# BetterAuth lives in the client. The API verifies its JWTs against this JWKS endpoint.
AUTH_URL=http://localhost:3000
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks   (optional override)
# AUTH_ISSUER=   (optional: require this issuer in tokens)
