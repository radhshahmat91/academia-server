# Copy to .env for local development (Node 22 loads it automatically on start)
PORT=5000
NODE_ENV=development

# Same database the Next.js client (BetterAuth) uses
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=academiaconnect

# Comma separated list of allowed browser origins (the Next.js client)
CLIENT_URL=http://localhost:3000

# BetterAuth lives in the client. The API verifies its JWTs against this JWKS endpoint.
AUTH_URL=http://localhost:3000
# AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks   (optional override)
